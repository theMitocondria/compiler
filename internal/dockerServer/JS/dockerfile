FROM golang:1.13-alpine AS go-builder

# Set the working directory inside the container
WORKDIR /app

# Copy the Go source code into the build environment
COPY server.go .

# Build the Go binary
RUN go build -o server server.go

# Step 2: Create a smaller image for running the Node.js environment with the Go application
FROM mhart/alpine-node:latest

# Set the working directory
WORKDIR /app

# Copy the compiled Go binary from the Go builder
COPY --from=go-builder /app/server .

# Expose any necessary ports (adjust as needed)
EXPOSE 8080

# Set the command to run the compiled Go server
CMD ["./server"]
